<section
  id="TrackCuratedDrops-{{ section.id }}"
  class="track-curated-drops"
  style="
    --tcd-bg: {{ section.settings.background_color }};
    --tcd-text: {{ section.settings.text_color }};
    --tcd-accent: {{ section.settings.accent_color }};
  "
>

  <div class="tcd-top">

    <div class="tcd-heading-wrap">
      {% if section.settings.eyebrow != blank %}
        <p class="tcd-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tcd-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    {% if section.settings.intro != blank %}
      <div class="tcd-intro">
        {{ section.settings.intro }}
      </div>
    {% endif %}

  </div>


  <div class="tcd-layout">

    <!-- LEFT FEATURE -->
    <article class="tcd-card tcd-card--large">

      {% if section.settings.image_one != blank %}
        {{
          section.settings.image_one
          | image_url: width: 2000
          | image_tag:
            class: 'tcd-image',
            loading: 'lazy',
            widths: '700, 1000, 1400, 1800, 2000',
            sizes: '(min-width: 990px) 62vw, 100vw',
            alt: section.settings.image_one.alt
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'tcd-placeholder' }}
      {% endif %}

      <div class="tcd-overlay"></div>

      <div class="tcd-index">01</div>

      {% if section.settings.badge_one != blank %}
        <span class="tcd-badge">
          {{ section.settings.badge_one }}
        </span>
      {% endif %}

      <div class="tcd-card-content">

        {% if section.settings.title_one != blank %}
          <h3 class="tcd-card-title">
            {{ section.settings.title_one }}
          </h3>
        {% endif %}

        {% if section.settings.text_one != blank %}
          <p class="tcd-card-text">
            {{ section.settings.text_one }}
          </p>
        {% endif %}

        {% if section.settings.button_one != blank %}
          <a
            class="tcd-button tcd-button--light"
            {% if section.settings.link_one != blank %}
              href="{{ section.settings.link_one }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ section.settings.button_one }}</span>
            <span class="tcd-button-arrow">↗</span>
          </a>
        {% endif %}

      </div>

    </article>


    <!-- RIGHT COLUMN -->
    <div class="tcd-right">

      <div class="tcd-statement">

        {% if section.settings.statement != blank %}
          <p class="tcd-statement-small">
            {{ section.settings.statement }}
          </p>
        {% endif %}

        {% if section.settings.statement_heading != blank %}
          <h3 class="tcd-statement-heading">
            {{ section.settings.statement_heading }}
          </h3>
        {% endif %}

        <div class="tcd-line-wrap">
          <span class="tcd-line"></span>
          <span>TRACK&TREAD / DROP 02</span>
        </div>

      </div>


      <article class="tcd-card tcd-card--small">

        {% if section.settings.image_two != blank %}
          {{
            section.settings.image_two
            | image_url: width: 1500
            | image_tag:
              class: 'tcd-image',
              loading: 'lazy',
              widths: '600, 800, 1000, 1200, 1500',
              sizes: '(min-width: 990px) 38vw, 100vw',
              alt: section.settings.image_two.alt
          }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'tcd-placeholder' }}
        {% endif %}

        <div class="tcd-overlay tcd-overlay--dark"></div>

        <div class="tcd-index">02</div>

        {% if section.settings.badge_two != blank %}
          <span class="tcd-badge">
            {{ section.settings.badge_two }}
          </span>
        {% endif %}

        <div class="tcd-card-content">

          {% if section.settings.title_two != blank %}
            <h3 class="tcd-card-title tcd-card-title--small">
              {{ section.settings.title_two }}
            </h3>
          {% endif %}

          {% if section.settings.text_two != blank %}
            <p class="tcd-card-text">
              {{ section.settings.text_two }}
            </p>
          {% endif %}

          {% if section.settings.button_two != blank %}
            <a
              class="tcd-button"
              {% if section.settings.link_two != blank %}
                href="{{ section.settings.link_two }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <span>{{ section.settings.button_two }}</span>
              <span class="tcd-button-arrow">↗</span>
            </a>
          {% endif %}

        </div>

      </article>

    </div>

  </div>


  {% if section.settings.show_bottom_marquee %}
    <div class="tcd-bottom-marquee">
      <div class="tcd-bottom-track">

        {% for repeat in (1..2) %}
          <div class="tcd-bottom-group">
            <span>CURATED FOR MOTION</span>
            <span class="tcd-star">✦</span>
            <span>BUILT FOR EVERYDAY</span>
            <span class="tcd-star">✦</span>
            <span>DESIGNED TO MOVE</span>
            <span class="tcd-star">✦</span>
          </div>
        {% endfor %}

      </div>
    </div>
  {% endif %}

</section>


<style>

#TrackCuratedDrops-{{ section.id }} {
  background: var(--tcd-bg);
  color: var(--tcd-text);
  overflow: hidden;
}


/* =========================
   TOP
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-top {
  display: grid;
  grid-template-columns: 1.5fr .5fr;
  align-items: end;
  gap: 50px;

  padding: 72px 28px 42px;

  border-bottom: 1px solid currentColor;
}

#TrackCuratedDrops-{{ section.id }} .tcd-eyebrow {
  margin: 0 0 12px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .18em;
  text-transform: uppercase;

  opacity: .5;
}

#TrackCuratedDrops-{{ section.id }} .tcd-heading {
  margin: 0;

  font-size: clamp(64px, 7.2vw, 138px);
  line-height: .82;

  font-weight: 500;

  letter-spacing: -.07em;

  max-width: 1200px;
}

#TrackCuratedDrops-{{ section.id }} .tcd-intro {
  max-width: 340px;

  margin-left: auto;

  font-size: 16px;
  line-height: 1.4;

  opacity: .7;
}

#TrackCuratedDrops-{{ section.id }} .tcd-intro p {
  margin: 0;
}


/* =========================
   MAIN LAYOUT
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-layout {
  display: grid;

  grid-template-columns: 62% 38%;

  min-height: 900px;
}

#TrackCuratedDrops-{{ section.id }} .tcd-right {
  display: grid;

  grid-template-rows: auto 1fr;

  border-left: 1px solid currentColor;
}


/* =========================
   CARDS
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-card {
  position: relative;

  overflow: hidden;

  min-height: 560px;

  background: #111;
}

#TrackCuratedDrops-{{ section.id }} .tcd-card--large {
  min-height: 900px;
}

#TrackCuratedDrops-{{ section.id }} .tcd-card--small {
  min-height: 610px;

  border-top: 1px solid currentColor;
}

#TrackCuratedDrops-{{ section.id }} .tcd-image,
#TrackCuratedDrops-{{ section.id }} .tcd-placeholder {
  width: 100%;
  height: 100%;

  position: absolute;
  inset: 0;

  display: block;

  object-fit: cover;

  transition:
    transform 1.1s cubic-bezier(.2,.7,.2,1),
    filter .5s ease;
}

@media (hover:hover) {

  #TrackCuratedDrops-{{ section.id }}
  .tcd-card:hover
  .tcd-image {

    transform: scale(1.045);

    filter: saturate(1.08);
  }

}


/* =========================
   OVERLAY
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.02) 15%,
      rgba(0,0,0,.18) 48%,
      rgba(0,0,0,.78) 100%
    );

  z-index: 1;
}

#TrackCuratedDrops-{{ section.id }} .tcd-overlay--dark {
  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.08) 10%,
      rgba(0,0,0,.25) 45%,
      rgba(0,0,0,.85) 100%
    );
}


/* =========================
   BADGE
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-badge {
  position: absolute;

  top: 22px;
  left: 22px;

  z-index: 3;

  display: inline-flex;
  align-items: center;

  min-height: 28px;

  padding: 0 10px;

  background: var(--tcd-accent);

  color: #000;

  border: 1px solid #000;

  font-size: 9px;
  font-weight: 700;

  letter-spacing: .1em;

  text-transform: uppercase;
}


/* =========================
   INDEX
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-index {
  position: absolute;

  top: 24px;
  right: 24px;

  z-index: 3;

  color: #fff;

  font-size: 11px;

  letter-spacing: .14em;

  opacity: .75;
}


/* =========================
   CARD CONTENT
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-card-content {
  position: absolute;

  left: 28px;
  right: 28px;
  bottom: 32px;

  z-index: 3;

  color: #fff;
}

#TrackCuratedDrops-{{ section.id }} .tcd-card-title {
  margin: 0;

  max-width: 800px;

  font-size: clamp(54px, 6vw, 112px);
  line-height: .88;

  font-weight: 500;

  letter-spacing: -.06em;
}

#TrackCuratedDrops-{{ section.id }} .tcd-card-title--small {
  font-size: clamp(48px, 4.8vw, 86px);
}

#TrackCuratedDrops-{{ section.id }} .tcd-card-text {
  max-width: 420px;

  margin: 18px 0 0;

  font-size: 15px;
  line-height: 1.4;

  opacity: .84;
}


/* =========================
   BUTTON
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-button {
  margin-top: 25px;

  min-width: 180px;
  min-height: 56px;

  padding: 0 17px;

  display: inline-flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;

  border: 1px solid #fff;

  background: transparent;

  color: #fff;

  text-decoration: none;

  font-size: 13px;

  text-transform: uppercase;

  letter-spacing: .04em;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}

#TrackCuratedDrops-{{ section.id }} .tcd-button--light {
  background: #fff;
  color: #000;
}

#TrackCuratedDrops-{{ section.id }} .tcd-button:hover {
  background: var(--tcd-accent);
  border-color: var(--tcd-accent);

  color: #000;

  transform: translateY(-3px);
}

#TrackCuratedDrops-{{ section.id }} .tcd-button-arrow {
  font-size: 18px;

  transition: transform .25s ease;
}

#TrackCuratedDrops-{{ section.id }}
.tcd-button:hover
.tcd-button-arrow {

  transform:
    translate(3px,-3px);
}


/* =========================
   RIGHT STATEMENT
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-statement {
  position: relative;

  padding: 42px 28px 36px;

  min-height: 290px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  background: var(--tcd-accent);

  color: #000;
}

#TrackCuratedDrops-{{ section.id }} .tcd-statement-small {
  margin: 0;

  max-width: 320px;

  font-size: 12px;
  line-height: 1.4;

  text-transform: uppercase;

  letter-spacing: .08em;
}

#TrackCuratedDrops-{{ section.id }} .tcd-statement-heading {
  margin: 20px 0 30px;

  max-width: 520px;

  font-size: clamp(36px, 4vw, 72px);
  line-height: .92;

  font-weight: 500;

  letter-spacing: -.05em;
}

#TrackCuratedDrops-{{ section.id }} .tcd-line-wrap {
  display: flex;

  align-items: center;

  gap: 12px;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .12em;
}

#TrackCuratedDrops-{{ section.id }} .tcd-line {
  width: 45px;
  height: 1px;

  background: #000;
}


/* =========================
   BOTTOM MARQUEE
========================= */

#TrackCuratedDrops-{{ section.id }} .tcd-bottom-marquee {
  overflow: hidden;

  border-top: 1px solid currentColor;
  border-bottom: 1px solid currentColor;

  background: #000;

  color: var(--tcd-accent);
}

#TrackCuratedDrops-{{ section.id }} .tcd-bottom-track {
  display: flex;

  width: max-content;

  animation:
    tcd-scroll-{{ section.id }}
    28s linear infinite;
}

#TrackCuratedDrops-{{ section.id }} .tcd-bottom-group {
  display: flex;

  flex-shrink: 0;

  align-items: center;

  min-height: 74px;
}

#TrackCuratedDrops-{{ section.id }} .tcd-bottom-group span {
  white-space: nowrap;

  font-size: clamp(26px, 2.2vw, 42px);

  line-height: 1;

  letter-spacing: -.04em;
}

#TrackCuratedDrops-{{ section.id }} .tcd-star {
  margin: 0 26px;
}

@keyframes tcd-scroll-{{ section.id }} {

  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }

}


/* =========================
   TABLET
========================= */

@media screen and (max-width: 989px) {

  #TrackCuratedDrops-{{ section.id }} .tcd-top {
    grid-template-columns: 1fr;

    gap: 20px;

    padding: 52px 20px 30px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-intro {
    max-width: 480px;

    margin-left: 0;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-layout {
    grid-template-columns: 1fr;

    min-height: 0;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-right {
    border-left: 0;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card--large {
    min-height: 720px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card--small {
    min-height: 650px;
  }

}


/* =========================
   MOBILE
========================= */

@media screen and (max-width: 749px) {

  #TrackCuratedDrops-{{ section.id }} .tcd-top {
    padding:
      42px 16px
      24px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-heading {
    font-size:
      clamp(52px, 16vw, 76px);
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-intro {
    font-size: 14px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card--large {
    min-height: 650px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card--small {
    min-height: 580px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card-content {
    left: 16px;
    right: 16px;
    bottom: 20px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card-title,
  #TrackCuratedDrops-{{ section.id }} .tcd-card-title--small {
    font-size:
      clamp(46px, 14vw, 70px);
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-card-text {
    font-size: 14px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-button {
    min-width: 165px;
    min-height: 52px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-statement {
    padding: 32px 16px 28px;

    min-height: 260px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-badge {
    top: 14px;
    left: 14px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-index {
    top: 16px;
    right: 16px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-bottom-group {
    min-height: 58px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-bottom-group span {
    font-size: 24px;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-star {
    margin: 0 18px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  #TrackCuratedDrops-{{ section.id }} .tcd-image,
  #TrackCuratedDrops-{{ section.id }} .tcd-button {
    transition: none;
  }

  #TrackCuratedDrops-{{ section.id }} .tcd-bottom-track {
    animation: none;
  }

}

</style>


{% schema %}
{
  "name": "Track Curated Drops",
  "tag": "section",
  "class": "track-curated-drops-section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SHOP THE EDIT"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CURATED DROPS"
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Two edits. One mindset. Designed for movement from city streets to training sessions.</p>"
    },

    {
      "type": "header",
      "content": "Feature One"
    },

    {
      "type": "image_picker",
      "id": "image_one",
      "label": "Large feature image"
    },

    {
      "type": "text",
      "id": "badge_one",
      "label": "Badge",
      "default": "WOMEN / DROP 01"
    },

    {
      "type": "text",
      "id": "title_one",
      "label": "Title",
      "default": "MOVE YOUR WAY."
    },

    {
      "type": "textarea",
      "id": "text_one",
      "label": "Description",
      "default": "Technical comfort meets effortless everyday style."
    },

    {
      "type": "text",
      "id": "button_one",
      "label": "Button",
      "default": "SHOP WOMEN"
    },

    {
      "type": "url",
      "id": "link_one",
      "label": "Button link"
    },

    {
      "type": "header",
      "content": "Middle Statement"
    },

    {
      "type": "text",
      "id": "statement",
      "label": "Small text",
      "default": "EDITORIAL PERFORMANCE ESSENTIALS"
    },

    {
      "type": "textarea",
      "id": "statement_heading",
      "label": "Statement",
      "default": "BUILT FOR MOTION. STYLED FOR EVERYWHERE."
    },

    {
      "type": "header",
      "content": "Feature Two"
    },

    {
      "type": "image_picker",
      "id": "image_two",
      "label": "Second feature image"
    },

    {
      "type": "text",
      "id": "badge_two",
      "label": "Badge",
      "default": "MEN / DROP 02"
    },

    {
      "type": "text",
      "id": "title_two",
      "label": "Title",
      "default": "BUILT TO GO."
    },

    {
      "type": "textarea",
      "id": "text_two",
      "label": "Description",
      "default": "Performance staples engineered for wherever the day takes you."
    },

    {
      "type": "text",
      "id": "button_two",
      "label": "Button",
      "default": "SHOP MEN"
    },

    {
      "type": "url",
      "id": "link_two",
      "label": "Button link"
    },

    {
      "type": "checkbox",
      "id": "show_bottom_marquee",
      "label": "Show bottom moving text",
      "default": true
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F1"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#C7FF00"
    }

  ],

  "presets": [
    {
      "name": "Track Curated Drops"
    }
  ]
}
{% endschema %}