<section
  id="TrackJournalStories-{{ section.id }}"
  class="track-journal-stories"
  style="
    --tjs-bg: {{ section.settings.background_color }};
    --tjs-text: {{ section.settings.text_color }};
    --tjs-accent: {{ section.settings.accent_color }};
    --tjs-border: {{ section.settings.border_color }};
  "
>

  <div class="tjs-head">

    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="tjs-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tjs-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="tjs-head-right">

      {% if section.settings.intro != blank %}
        <div class="tjs-intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}

      {% if section.settings.blog != blank and section.settings.show_view_all %}
        <a
          class="tjs-view-all"
          href="{{ section.settings.blog.url }}"
        >
          <span>VIEW JOURNAL</span>
          <span>↗</span>
        </a>
      {% endif %}

    </div>

  </div>


  {% if section.settings.blog != blank %}

    {% assign articles = section.settings.blog.articles %}

    <div class="tjs-grid">

      <!-- FEATURED STORY -->
      {% if articles[0] %}

        {% assign featured_article = articles[0] %}

        <article class="tjs-feature">

          <a
            href="{{ featured_article.url }}"
            class="tjs-feature-media"
          >
            {% if featured_article.image != blank %}
              {{
                featured_article.image
                | image_url: width: 1800
                | image_tag:
                  class: 'tjs-image',
                  loading: 'lazy',
                  widths: '700, 1000, 1400, 1800',
                  sizes: '(min-width: 990px) 64vw, 100vw',
                  alt: featured_article.image.alt
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'tjs-placeholder' }}
            {% endif %}

            <div class="tjs-overlay"></div>

            <span class="tjs-index">
              01
            </span>

            <div class="tjs-feature-badge">
              FEATURED STORY
            </div>

            <div class="tjs-feature-arrow">
              ↗
            </div>
          </a>


          <div class="tjs-feature-copy">

            <div class="tjs-meta">
              <span>
                {{ featured_article.published_at | date: "%d.%m.%Y" }}
              </span>

              {% if featured_article.tags.size > 0 %}
                <span>
                  {{ featured_article.tags.first }}
                </span>
              {% else %}
                <span>JOURNAL</span>
              {% endif %}
            </div>

            <h3 class="tjs-feature-title">
              <a href="{{ featured_article.url }}">
                {{ featured_article.title }}
              </a>
            </h3>

            {% if section.settings.show_excerpt %}
              <div class="tjs-feature-excerpt">
                {% if featured_article.excerpt != blank %}
                  {{ featured_article.excerpt | strip_html | truncatewords: 24 }}
                {% else %}
                  {{ featured_article.content | strip_html | truncatewords: 24 }}
                {% endif %}
              </div>
            {% endif %}

            <a
              href="{{ featured_article.url }}"
              class="tjs-read-link"
            >
              <span>READ STORY</span>
              <span>→</span>
            </a>

          </div>

        </article>

      {% endif %}


      <!-- SIDE STORIES -->
      <div class="tjs-side">

        {% for article in articles limit: 2 offset: 1 %}

          <article class="tjs-side-card">

            <a
              href="{{ article.url }}"
              class="tjs-side-media"
            >
              {% if article.image != blank %}
                {{
                  article.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'tjs-image',
                    loading: 'lazy',
                    widths: '500, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 36vw, 100vw',
                    alt: article.image.alt
                }}
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'tjs-placeholder' }}
              {% endif %}

              <div class="tjs-overlay tjs-overlay--light"></div>

              <span class="tjs-index">
                0{{ forloop.index | plus: 1 }}
              </span>

              <div class="tjs-side-arrow">
                ↗
              </div>
            </a>


            <div class="tjs-side-copy">

              <div class="tjs-meta">
                <span>
                  {{ article.published_at | date: "%d.%m.%Y" }}
                </span>

                {% if article.tags.size > 0 %}
                  <span>
                    {{ article.tags.first }}
                  </span>
                {% else %}
                  <span>STORY</span>
                {% endif %}
              </div>

              <h3 class="tjs-side-title">
                <a href="{{ article.url }}">
                  {{ article.title }}
                </a>
              </h3>

              <a
                href="{{ article.url }}"
                class="tjs-read-link"
              >
                <span>READ STORY</span>
                <span>→</span>
              </a>

            </div>

          </article>

        {% endfor %}

      </div>

    </div>


    {% if articles.size > 3 %}

      <div class="tjs-more">

        {% for article in articles limit: 3 offset: 3 %}

          <a
            href="{{ article.url }}"
            class="tjs-more-item"
          >

            <span class="tjs-more-number">
              0{{ forloop.index | plus: 3 }}
            </span>

            <span class="tjs-more-title">
              {{ article.title }}
            </span>

            <span class="tjs-more-date">
              {{ article.published_at | date: "%b %d, %Y" }}
            </span>

            <span class="tjs-more-arrow">
              ↗
            </span>

          </a>

        {% endfor %}

      </div>

    {% endif %}


    {% if section.settings.show_bottom_strip %}
      <div class="tjs-strip">

        <div class="tjs-strip-track">

          {% for repeat in (1..2) %}

            <div class="tjs-strip-group">

              <span>STORIES THAT MOVE</span>
              <span class="tjs-strip-dot">✦</span>

              <span>TRAINING</span>
              <span class="tjs-strip-dot">✦</span>

              <span>RECOVERY</span>
              <span class="tjs-strip-dot">✦</span>

              <span>STYLE</span>
              <span class="tjs-strip-dot">✦</span>

              <span>PERFORMANCE</span>
              <span class="tjs-strip-dot">✦</span>

            </div>

          {% endfor %}

        </div>

      </div>
    {% endif %}


  {% else %}

    <div class="tjs-empty">

      <span>01</span>

      <p>
        Select a blog in the Theme Editor to display stories.
      </p>

    </div>

  {% endif %}

</section>


<style>

#TrackJournalStories-{{ section.id }} {
  background: var(--tjs-bg);
  color: var(--tjs-text);
  overflow: hidden;
  border-top: 1px solid var(--tjs-border);
}


/* HEADER */

#TrackJournalStories-{{ section.id }} .tjs-head {
  display: grid;
  grid-template-columns: 1.45fr .55fr;
  gap: 50px;
  align-items: end;

  padding: 72px 28px 40px;

  border-bottom: 1px solid var(--tjs-border);
}

#TrackJournalStories-{{ section.id }} .tjs-eyebrow {
  margin: 0 0 12px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .18em;
  text-transform: uppercase;

  opacity: .5;
}

#TrackJournalStories-{{ section.id }} .tjs-heading {
  margin: 0;

  max-width: 1100px;

  font-size: clamp(62px, 6.7vw, 128px);
  line-height: .84;

  font-weight: 500;
  letter-spacing: -.07em;
}

#TrackJournalStories-{{ section.id }} .tjs-head-right {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  gap: 26px;
}

#TrackJournalStories-{{ section.id }} .tjs-intro {
  max-width: 350px;

  font-size: 15px;
  line-height: 1.45;

  opacity: .66;
}

#TrackJournalStories-{{ section.id }} .tjs-intro p {
  margin: 0;
}

#TrackJournalStories-{{ section.id }} .tjs-view-all {
  display: inline-flex;
  align-items: center;

  gap: 11px;

  padding-bottom: 7px;

  color: inherit;
  text-decoration: none;

  border-bottom: 1px solid currentColor;

  font-size: 9px;
  letter-spacing: .13em;

  transition:
    gap .25s ease,
    opacity .25s ease;
}

#TrackJournalStories-{{ section.id }} .tjs-view-all:hover {
  gap: 18px;
  opacity: .55;
}


/* GRID */

#TrackJournalStories-{{ section.id }} .tjs-grid {
  display: grid;
  grid-template-columns: 64% 36%;

  min-height: 900px;

  border-bottom: 1px solid var(--tjs-border);
}


/* FEATURE */

#TrackJournalStories-{{ section.id }} .tjs-feature {
  display: grid;
  grid-template-rows: 1fr auto;

  min-width: 0;

  border-right: 1px solid var(--tjs-border);
}

#TrackJournalStories-{{ section.id }} .tjs-feature-media {
  position: relative;

  display: block;

  min-height: 660px;

  overflow: hidden;

  background: #111;
}

#TrackJournalStories-{{ section.id }} .tjs-image,
#TrackJournalStories-{{ section.id }} .tjs-placeholder {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;

  transition:
    transform 1s cubic-bezier(.2,.7,.2,1),
    filter .4s ease;
}

#TrackJournalStories-{{ section.id }} .tjs-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.03),
      rgba(0,0,0,.08) 55%,
      rgba(0,0,0,.48)
    );
}

#TrackJournalStories-{{ section.id }} .tjs-overlay--light {
  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.02),
      rgba(0,0,0,.06) 55%,
      rgba(0,0,0,.42)
    );
}


/* FEATURE BADGE */

#TrackJournalStories-{{ section.id }} .tjs-feature-badge {
  position: absolute;

  z-index: 4;

  left: 18px;
  bottom: 18px;

  min-height: 30px;

  padding: 0 11px;

  display: inline-flex;
  align-items: center;

  background: var(--tjs-accent);
  color: #000;

  border: 1px solid #000;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .11em;
}


/* INDEX */

#TrackJournalStories-{{ section.id }} .tjs-index {
  position: absolute;

  z-index: 4;

  top: 18px;
  left: 18px;

  font-size: 9px;

  letter-spacing: .13em;

  color: #fff;

  opacity: .8;
}


/* FEATURE ARROW */

#TrackJournalStories-{{ section.id }} .tjs-feature-arrow,
#TrackJournalStories-{{ section.id }} .tjs-side-arrow {
  position: absolute;

  z-index: 4;

  right: 18px;
  bottom: 18px;

  width: 58px;
  height: 58px;

  border-radius: 50%;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #fff;
  color: #000;

  font-size: 22px;

  transition:
    background .3s ease,
    transform .3s ease;
}


/* FEATURE COPY */

#TrackJournalStories-{{ section.id }} .tjs-feature-copy {
  padding: 26px 28px 30px;
}

#TrackJournalStories-{{ section.id }} .tjs-meta {
  display: flex;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 13px;

  font-size: 8px;

  letter-spacing: .13em;
  text-transform: uppercase;

  opacity: .45;
}

#TrackJournalStories-{{ section.id }} .tjs-feature-title {
  margin: 0;

  max-width: 920px;

  font-size: clamp(46px, 4.5vw, 84px);
  line-height: .92;

  font-weight: 500;

  letter-spacing: -.055em;
}

#TrackJournalStories-{{ section.id }} .tjs-feature-title a,
#TrackJournalStories-{{ section.id }} .tjs-side-title a {
  color: inherit;
  text-decoration: none;
}

#TrackJournalStories-{{ section.id }} .tjs-feature-excerpt {
  max-width: 620px;

  margin-top: 18px;

  font-size: 15px;
  line-height: 1.45;

  opacity: .65;
}

#TrackJournalStories-{{ section.id }} .tjs-read-link {
  margin-top: 20px;

  width: fit-content;

  display: inline-flex;
  align-items: center;

  gap: 16px;

  color: inherit;
  text-decoration: none;

  font-size: 9px;

  letter-spacing: .12em;

  text-transform: uppercase;

  transition:
    gap .25s ease,
    opacity .25s ease;
}

#TrackJournalStories-{{ section.id }} .tjs-read-link:hover {
  gap: 23px;
  opacity: .55;
}


/* SIDE */

#TrackJournalStories-{{ section.id }} .tjs-side {
  display: grid;
  grid-template-rows: 1fr 1fr;
}

#TrackJournalStories-{{ section.id }} .tjs-side-card {
  display: grid;
  grid-template-rows: 1fr auto;

  min-height: 450px;

  border-bottom: 1px solid var(--tjs-border);
}

#TrackJournalStories-{{ section.id }} .tjs-side-card:last-child {
  border-bottom: 0;
}

#TrackJournalStories-{{ section.id }} .tjs-side-media {
  position: relative;

  min-height: 280px;

  overflow: hidden;

  display: block;

  background: #111;
}

#TrackJournalStories-{{ section.id }} .tjs-side-arrow {
  width: 46px;
  height: 46px;

  font-size: 17px;
}

#TrackJournalStories-{{ section.id }} .tjs-side-copy {
  padding: 19px 20px 22px;
}

#TrackJournalStories-{{ section.id }} .tjs-side-title {
  margin: 0;

  max-width: 500px;

  font-size: clamp(28px, 2.5vw, 47px);
  line-height: .95;

  font-weight: 500;

  letter-spacing: -.05em;
}


/* HOVER */

@media (hover:hover) {

  #TrackJournalStories-{{ section.id }}
  .tjs-feature:hover
  .tjs-image,

  #TrackJournalStories-{{ section.id }}
  .tjs-side-card:hover
  .tjs-image {

    transform: scale(1.055);

    filter: saturate(1.06);
  }

  #TrackJournalStories-{{ section.id }}
  .tjs-feature:hover
  .tjs-feature-arrow,

  #TrackJournalStories-{{ section.id }}
  .tjs-side-card:hover
  .tjs-side-arrow {

    background: var(--tjs-accent);

    transform:
      rotate(45deg)
      scale(1.07);
  }

}


/* MORE STORIES */

#TrackJournalStories-{{ section.id }} .tjs-more {
  border-bottom: 1px solid var(--tjs-border);
}

#TrackJournalStories-{{ section.id }} .tjs-more-item {
  display: grid;

  grid-template-columns:
    70px
    minmax(0,1fr)
    140px
    48px;

  align-items: center;

  min-height: 94px;

  padding: 0 28px;

  color: inherit;
  text-decoration: none;

  border-bottom: 1px solid var(--tjs-border);

  transition:
    background .25s ease;
}

#TrackJournalStories-{{ section.id }} .tjs-more-item:last-child {
  border-bottom: 0;
}

#TrackJournalStories-{{ section.id }} .tjs-more-number,
#TrackJournalStories-{{ section.id }} .tjs-more-date {
  font-size: 8px;

  letter-spacing: .12em;

  opacity: .45;
}

#TrackJournalStories-{{ section.id }} .tjs-more-title {
  padding-right: 30px;

  font-size: clamp(20px, 2vw, 34px);

  line-height: 1;

  letter-spacing: -.035em;
}

#TrackJournalStories-{{ section.id }} .tjs-more-arrow {
  width: 40px;
  height: 40px;

  border-radius: 50%;

  border: 1px solid #000;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 15px;

  transition:
    background .25s ease,
    transform .25s ease;
}

@media (hover:hover) {

  #TrackJournalStories-{{ section.id }}
  .tjs-more-item:hover {

    background: var(--tjs-accent);
  }

  #TrackJournalStories-{{ section.id }}
  .tjs-more-item:hover
  .tjs-more-arrow {

    background: #000;
    color: #fff;

    transform: rotate(45deg);
  }

}


/* STRIP */

#TrackJournalStories-{{ section.id }} .tjs-strip {
  overflow: hidden;

  background: #000;

  color: var(--tjs-accent);

  border-bottom: 1px solid #000;
}

#TrackJournalStories-{{ section.id }} .tjs-strip-track {
  display: flex;

  width: max-content;

  animation:
    tjs-strip-{{ section.id }}
    30s linear infinite;
}

#TrackJournalStories-{{ section.id }} .tjs-strip-group {
  display: flex;

  flex-shrink: 0;

  align-items: center;

  min-height: 68px;
}

#TrackJournalStories-{{ section.id }} .tjs-strip-group span {
  white-space: nowrap;

  font-size: clamp(24px, 2vw, 40px);

  line-height: 1;

  letter-spacing: -.04em;
}

#TrackJournalStories-{{ section.id }} .tjs-strip-dot {
  margin: 0 24px;
}

@keyframes tjs-strip-{{ section.id }} {

  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }

}


/* EMPTY */

#TrackJournalStories-{{ section.id }} .tjs-empty {
  min-height: 320px;

  padding: 40px 28px;

  display: flex;
  flex-direction: column;

  justify-content: space-between;

  border-bottom: 1px solid var(--tjs-border);
}

#TrackJournalStories-{{ section.id }} .tjs-empty span {
  font-size: 9px;

  opacity: .4;
}

#TrackJournalStories-{{ section.id }} .tjs-empty p {
  margin: 0;

  max-width: 700px;

  font-size: clamp(34px, 4vw, 64px);

  line-height: .95;

  letter-spacing: -.05em;
}


/* TABLET */

@media screen and (max-width: 989px) {

  #TrackJournalStories-{{ section.id }} .tjs-head {
    grid-template-columns: 1fr;

    gap: 22px;

    padding: 54px 20px 30px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-head-right {
    max-width: 500px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-grid {
    grid-template-columns: 1fr;

    min-height: 0;
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature {
    border-right: 0;
    border-bottom: 1px solid var(--tjs-border);
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature-media {
    min-height: 650px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: none;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-card {
    border-bottom: 0;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-card:first-child {
    border-right: 1px solid var(--tjs-border);
  }

}


/* MOBILE */

@media screen and (max-width: 749px) {

  #TrackJournalStories-{{ section.id }} .tjs-head {
    padding: 42px 16px 24px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-heading {
    font-size: clamp(50px, 15vw, 76px);
  }

  #TrackJournalStories-{{ section.id }} .tjs-intro {
    font-size: 14px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature-media {
    min-height: 520px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature-copy {
    padding: 20px 16px 24px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature-title {
    font-size: clamp(38px, 11vw, 58px);
  }

  #TrackJournalStories-{{ section.id }} .tjs-feature-excerpt {
    font-size: 14px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side {
    grid-template-columns: 1fr;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-card:first-child {
    border-right: 0;
    border-bottom: 1px solid var(--tjs-border);
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-media {
    min-height: 420px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-copy {
    padding: 18px 16px 22px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-side-title {
    font-size: clamp(30px, 9vw, 46px);
  }

  #TrackJournalStories-{{ section.id }} .tjs-more-item {
    grid-template-columns:
      42px
      minmax(0,1fr)
      40px;

    padding: 0 16px;

    min-height: 84px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-more-date {
    display: none;
  }

  #TrackJournalStories-{{ section.id }} .tjs-more-title {
    font-size: 18px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-strip-group {
    min-height: 56px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-strip-group span {
    font-size: 23px;
  }

  #TrackJournalStories-{{ section.id }} .tjs-strip-dot {
    margin: 0 17px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  #TrackJournalStories-{{ section.id }} .tjs-image,
  #TrackJournalStories-{{ section.id }} .tjs-feature-arrow,
  #TrackJournalStories-{{ section.id }} .tjs-side-arrow {

    transition: none;
  }

  #TrackJournalStories-{{ section.id }} .tjs-strip-track {
    animation: none;
  }

}

</style>


{% schema %}
{
  "name": "Track Journal Stories",
  "tag": "section",
  "class": "track-journal-stories-section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE JOURNAL"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "STORIES THAT MOVE"
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Training ideas, movement culture and stories designed to keep you moving forward.</p>"
    },

    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View Journal link",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show featured article excerpt",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_bottom_strip",
      "label": "Show moving story strip",
      "default": true
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F1"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#111111"
    },

    {
