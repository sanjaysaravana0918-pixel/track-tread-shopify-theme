<section
  id="TrackTestimonials-{{ section.id }}"
  class="track-testimonials"
  style="
    --tt-bg: {{ section.settings.background_color }};
    --tt-text: {{ section.settings.text_color }};
    --tt-accent: {{ section.settings.accent_color }};
    --tt-border: {{ section.settings.border_color }};
    --tt-muted: {{ section.settings.muted_color }};
  "
>

  <div class="tt-head">
    <div>
      {% if section.settings.eyebrow != blank %}
        <div class="tt-eyebrow">
          <span class="tt-dot"></span>
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tt-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    {% if section.settings.intro != blank %}
      <div class="tt-intro">
        {{ section.settings.intro }}
      </div>
    {% endif %}
  </div>


  <div class="tt-slider" data-tt-slider>

    {% for block in section.blocks %}
      <article
        class="tt-slide {% if forloop.first %}is-active{% endif %}"
        data-tt-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >

        <div class="tt-copy">

          <div class="tt-top-meta">
            <span class="tt-index">
              0{{ forloop.index }}
            </span>

            <div class="tt-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {% for i in (1..5) %}
                <span class="{% if i <= block.settings.rating %}is-filled{% endif %}">★</span>
              {% endfor %}
            </div>
          </div>


          {% if block.settings.quote != blank %}
            <blockquote class="tt-quote">
              “{{ block.settings.quote }}”
            </blockquote>
          {% endif %}


          <div class="tt-person">

            <div class="tt-person-left">
              <strong class="tt-name">
                {{ block.settings.name }}
              </strong>

              {% if block.settings.meta != blank %}
                <span class="tt-meta">
                  {{ block.settings.meta }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.product_name != blank %}
              <div class="tt-product-ref">
                <span>WORN WITH</span>
                <strong>{{ block.settings.product_name }}</strong>
              </div>
            {% endif %}

          </div>


          {% if block.settings.button_label != blank %}
            <a
              class="tt-button"
              {% if block.settings.button_link != blank %}
                href="{{ block.settings.button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <span>{{ block.settings.button_label }}</span>
              <span class="tt-button-arrow">↗</span>
            </a>
          {% endif %}

        </div>


        <div class="tt-media">

          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 1800
              | image_tag:
                class: 'tt-image',
                loading: 'lazy',
                widths: '700, 1000, 1400, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: block.settings.image.alt
            }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'tt-placeholder' }}
          {% endif %}

          <div class="tt-overlay"></div>

          <div class="tt-badge">
            COMMUNITY VOICE
          </div>

          <div class="tt-stamp">
            <span>TRACK</span>
            <span>&TREAD</span>
          </div>

        </div>

      </article>
    {% endfor %}

  </div>


  {% if section.blocks.size > 0 %}
    <div class="tt-controls">

      <div class="tt-tabs">

        {% for block in section.blocks %}
          <button
            type="button"
            class="tt-tab {% if forloop.first %}is-active{% endif %}"
            data-tt-tab="{{ forloop.index0 }}"
            aria-label="Show testimonial {{ forloop.index }}"
          >
            <span class="tt-tab-number">
              0{{ forloop.index }}
            </span>

            <span class="tt-tab-name">
              {{ block.settings.name }}
            </span>

            <span class="tt-tab-line"></span>
          </button>
        {% endfor %}

      </div>


      <div class="tt-arrows">
        <button
          type="button"
          class="tt-arrow"
          data-tt-prev
          aria-label="Previous testimonial"
        >
          ←
        </button>

        <button
          type="button"
          class="tt-arrow tt-arrow--next"
          data-tt-next
          aria-label="Next testimonial"
        >
          →
        </button>
      </div>

    </div>
  {% endif %}

</section>


<style>

#TrackTestimonials-{{ section.id }} {
  background: var(--tt-bg);
  color: var(--tt-text);
  overflow: hidden;

  border-top: 1px solid var(--tt-border);
}


/* HEADER */

#TrackTestimonials-{{ section.id }} .tt-head {
  display: grid;
  grid-template-columns: 1.45fr .55fr;
  align-items: end;
  gap: 50px;

  padding: 74px 30px 40px;

  border-bottom: 1px solid var(--tt-border);
}

#TrackTestimonials-{{ section.id }} .tt-eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;

  margin-bottom: 14px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .18em;
  text-transform: uppercase;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--tt-accent);
}

#TrackTestimonials-{{ section.id }} .tt-heading {
  margin: 0;

  font-size: clamp(62px, 6.8vw, 132px);
  line-height: .82;

  font-weight: 500;
  letter-spacing: -.07em;
}

#TrackTestimonials-{{ section.id }} .tt-intro {
  max-width: 360px;

  margin-left: auto;

  font-size: 15px;
  line-height: 1.45;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-intro p {
  margin: 0;
}


/* SLIDER */

#TrackTestimonials-{{ section.id }} .tt-slider {
  position: relative;
}

#TrackTestimonials-{{ section.id }} .tt-slide {
  display: none;

  grid-template-columns: 50% 50%;

  min-height: 760px;
}

#TrackTestimonials-{{ section.id }} .tt-slide.is-active {
  display: grid;

  animation:
    ttFade-{{ section.id }}
    .45s ease both;
}

@keyframes ttFade-{{ section.id }} {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}


/* LEFT */

#TrackTestimonials-{{ section.id }} .tt-copy {
  position: relative;

  padding: 34px 32px 32px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  border-right: 1px solid var(--tt-border);
}

#TrackTestimonials-{{ section.id }} .tt-top-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;
}

#TrackTestimonials-{{ section.id }} .tt-index {
  font-size: 9px;

  letter-spacing: .14em;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-stars {
  display: flex;
  gap: 4px;

  font-size: 14px;
}

#TrackTestimonials-{{ section.id }} .tt-stars span {
  color: rgba(255,255,255,.18);
}

#TrackTestimonials-{{ section.id }} .tt-stars .is-filled {
  color: var(--tt-accent);
}


/* QUOTE */

#TrackTestimonials-{{ section.id }} .tt-quote {
  margin: auto 0;

  max-width: 760px;

  font-size: clamp(42px, 4.6vw, 86px);
  line-height: .95;

  font-weight: 500;
  letter-spacing: -.06em;
}

#TrackTestimonials-{{ section.id }} .tt-person {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  padding-top: 24px;

  border-top: 1px solid rgba(255,255,255,.15);
}

#TrackTestimonials-{{ section.id }} .tt-person-left {
  display: flex;
  flex-direction: column;

  gap: 5px;
}

#TrackTestimonials-{{ section.id }} .tt-name {
  font-size: 14px;
  font-weight: 500;
}

#TrackTestimonials-{{ section.id }} .tt-meta {
  font-size: 9px;

  letter-spacing: .12em;
  text-transform: uppercase;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-product-ref {
  text-align: right;

  display: flex;
  flex-direction: column;

  gap: 4px;
}

#TrackTestimonials-{{ section.id }} .tt-product-ref span {
  font-size: 8px;

  letter-spacing: .12em;
  text-transform: uppercase;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-product-ref strong {
  font-size: 12px;
  font-weight: 500;
}


/* BUTTON */

#TrackTestimonials-{{ section.id }} .tt-button {
  width: fit-content;

  min-width: 190px;
  min-height: 54px;

  margin-top: 26px;

  padding: 0 14px;

  display: inline-flex;
  align-items: center;
  justify-content: space-between;

  gap: 25px;

  background: var(--tt-accent);
  color: #000;

  border: 1px solid #000;

  text-decoration: none;

  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;

  transition:
    transform .25s ease,
    background .25s ease;
}

#TrackTestimonials-{{ section.id }} .tt-button:hover {
  transform: translateY(-3px);

  background: #fff;
}

#TrackTestimonials-{{ section.id }} .tt-button-arrow {
  font-size: 18px;
}


/* RIGHT IMAGE */

#TrackTestimonials-{{ section.id }} .tt-media {
  position: relative;

  min-height: 760px;

  overflow: hidden;

  background: #111;
}

#TrackTestimonials-{{ section.id }} .tt-image,
#TrackTestimonials-{{ section.id }} .tt-placeholder {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 1s cubic-bezier(.2,.7,.2,1),
    filter .4s ease;
}

#TrackTestimonials-{{ section.id }} .tt-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.02),
      rgba(0,0,0,.08) 55%,
      rgba(0,0,0,.46)
    );
}

#TrackTestimonials-{{ section.id }} .tt-badge {
  position: absolute;

  z-index: 3;

  top: 20px;
  left: 20px;

  min-height: 30px;

  padding: 0 10px;

  display: flex;
  align-items: center;

  background: var(--tt-accent);
  color: #000;

  border: 1px solid #000;

  font-size: 8px;
  font-weight: 700;

  letter-spacing: .11em;
}

#TrackTestimonials-{{ section.id }} .tt-stamp {
  position: absolute;

  z-index: 3;

  right: 24px;
  bottom: 24px;

  width: 100px;
  height: 100px;

  border-radius: 50%;

  border: 1px solid #fff;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  color: #fff;

  font-size: 9px;
  letter-spacing: .12em;

  transform: rotate(-8deg);

  transition:
    transform .3s ease,
    background .3s ease,
    color .3s ease;
}


/* HOVER */

@media (hover:hover) {

  #TrackTestimonials-{{ section.id }} .tt-slide:hover .tt-image {
    transform: scale(1.045);

    filter: saturate(1.05);
  }

  #TrackTestimonials-{{ section.id }} .tt-slide:hover .tt-stamp {
    transform: rotate(0deg);

    background: var(--tt-accent);
    color: #000;

    border-color: var(--tt-accent);
  }

}


/* CONTROLS */

#TrackTestimonials-{{ section.id }} .tt-controls {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 30px;

  align-items: center;

  padding: 0 28px;

  min-height: 118px;

  border-top: 1px solid var(--tt-border);
  border-bottom: 1px solid var(--tt-border);
}

#TrackTestimonials-{{ section.id }} .tt-tabs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));

  gap: 0;
}

#TrackTestimonials-{{ section.id }} .tt-tab {
  position: relative;

  appearance: none;

  min-height: 76px;

  padding: 12px 16px;

  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;

  gap: 6px;

  background: transparent;
  color: inherit;

  border: 0;
  border-right: 1px solid var(--tt-border);

  cursor: pointer;

  text-align: left;

  transition:
    background .25s ease,
    color .25s ease;
}

#TrackTestimonials-{{ section.id }} .tt-tab:first-child {
  border-left: 1px solid var(--tt-border);
}

#TrackTestimonials-{{ section.id }} .tt-tab-number {
  font-size: 8px;

  letter-spacing: .12em;

  color: var(--tt-muted);
}

#TrackTestimonials-{{ section.id }} .tt-tab-name {
  font-size: 13px;
}

#TrackTestimonials-{{ section.id }} .tt-tab-line {
  position: absolute;

  left: 0;
  right: 100%;
  bottom: 0;

  height: 3px;

  background: var(--tt-accent);

  transition: right .3s ease;
}

#TrackTestimonials-{{ section.id }} .tt-tab.is-active {
  background: rgba(255,255,255,.035);
}

#TrackTestimonials-{{ section.id }} .tt-tab.is-active .tt-tab-line {
  right: 0;
}

#TrackTestimonials-{{ section.id }} .tt-tab.is-active .tt-tab-number {
  color: var(--tt-accent);
}


/* ARROWS */

#TrackTestimonials-{{ section.id }} .tt-arrows {
  display: flex;

  gap: 8px;
}

#TrackTestimonials-{{ section.id }} .tt-arrow {
  width: 56px;
  height: 56px;

  border-radius: 50%;

  border: 1px solid var(--tt-border);

  background: transparent;
  color: var(--tt-text);

  cursor: pointer;

  font-size: 18px;

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}

#TrackTestimonials-{{ section.id }} .tt-arrow:hover {
  background: var(--tt-accent);
  color: #000;

  transform: scale(1.05);
}

#TrackTestimonials-{{ section.id }} .tt-arrow--next {
  background: var(--tt-accent);
  color: #000;
}


/* TABLET */

@media screen and (max-width: 989px) {

  #TrackTestimonials-{{ section.id }} .tt-head {
    grid-template-columns: 1fr;

    gap: 22px;

    padding: 54px 20px 30px;
  }

  #TrackTestimonials-{{ section.id }} .tt-intro {
    margin-left: 0;

    max-width: 500px;
  }

  #TrackTestimonials-{{ section.id }} .tt-slide,
  #TrackTestimonials-{{ section.id }} .tt-slide.is-active {
    grid-template-columns: 1fr;
  }

  #TrackTestimonials-{{ section.id }} .tt-copy {
    min-height: 600px;

    border-right: 0;
    border-bottom: 1px solid var(--tt-border);
  }

  #TrackTestimonials-{{ section.id }} .tt-media {
    min-height: 650px;
  }

}


/* MOBILE */

@media screen and (max-width: 749px) {

  #TrackTestimonials-{{ section.id }} .tt-head {
    padding: 42px 16px 24px;
  }

  #TrackTestimonials-{{ section.id }} .tt-heading {
    font-size: clamp(50px, 15vw, 76px);
  }

  #TrackTestimonials-{{ section.id }} .tt-intro {
    font-size: 14px;
  }

  #TrackTestimonials-{{ section.id }} .tt-copy {
    min-height: 520px;

    padding: 24px 16px;
  }

  #TrackTestimonials-{{ section.id }} .tt-quote {
    font-size: clamp(36px, 11vw, 54px);
  }

  #TrackTestimonials-{{ section.id }} .tt-person {
    flex-direction: column;
    align-items: flex-start;

    gap: 15px;
  }

  #TrackTestimonials-{{ section.id }} .tt-product-ref {
    text-align: left;
  }

  #TrackTestimonials-{{ section.id }} .tt-media {
    min-height: 520px;
  }

  #TrackTestimonials-{{ section.id }} .tt-stamp {
    width: 78px;
    height: 78px;

    right: 14px;
    bottom: 14px;

    font-size: 7px;
  }

  #TrackTestimonials-{{ section.id }} .tt-controls {
    grid-template-columns: 1fr;

    padding: 14px 16px 18px;

    gap: 14px;
  }

  #TrackTestimonials-{{ section.id }} .tt-tabs {
    grid-template-columns: 1fr;
  }

  #TrackTestimonials-{{ section.id }} .tt-tab {
    min-height: 58px;

    border-left: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
  }

  #TrackTestimonials-{{ section.id }} .tt-arrows {
    justify-content: flex-end;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  #TrackTestimonials-{{ section.id }} .tt-slide.is-active {
    animation: none;
  }

  #TrackTestimonials-{{ section.id }} .tt-image,
  #TrackTestimonials-{{ section.id }} .tt-stamp,
  #TrackTestimonials-{{ section.id }} .tt-tab-line {
    transition: none;
  }

}

</style>


<script>
(function () {

  var section = document.getElementById(
    'TrackTestimonials-{{ section.id }}'
  );

  if (!section) return;

  var slides = Array.prototype.slice.call(
    section.querySelectorAll('[data-tt-slide]')
  );

  var tabs = Array.prototype.slice.call(
    section.querySelectorAll('[data-tt-tab]')
  );

  var prev = section.querySelector('[data-tt-prev]');
  var next = section.querySelector('[data-tt-next]');

  if (!slides.length) return;

  var current = 0;


  function showSlide(index) {

    if (index < 0) {
      index = slides.length - 1;
    }

    if (index >= slides.length) {
      index = 0;
    }

    current = index;


    slides.forEach(function (slide, i) {
      slide.classList.toggle(
        'is-active',
        i === current
      );
    });


    tabs.forEach(function (tab, i) {
      tab.classList.toggle(
        'is-active',
        i === current
      );
    });

  }


  tabs.forEach(function (tab) {

    tab.addEventListener(
      'click',
      function () {

        var index = parseInt(
          tab.getAttribute('data-tt-tab'),
          10
        );

        showSlide(index);

      }
    );

  });


  if (prev) {
    prev.addEventListener(
      'click',
      function () {
        showSlide(current - 1);
      }
    );
  }


  if (next) {
    next.addEventListener(
      'click',
      function () {
        showSlide(current + 1);
      }
    );
  }

})();
</script>


{% schema %}
{
  "name": "Track Testimonials",
  "tag": "section",
  "class": "track-testimonials-section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "COMMUNITY VOICES"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WORN. TESTED. LOVED."
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Real movement. Real routines. Real feedback from people who wear Track&Tread every day.</p>"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#080808"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },

    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#9B9B9B"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#2B2B2B"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#C7FF00"
    }

  ],

  "blocks": [

    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [

        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The cushioning feels light without losing support. I can wear them for training, travel and the rest of the day."
        },

        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Maya R."
        },

        {
          "type": "text",
          "id": "meta",
          "label": "Location / role",
          "default": "RUNNER / BENGALURU"
        },

        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },

        {
          "type": "text",
          "id": "product_name",
          "label": "Product name",
          "default": "Nimbus Glide Icecore"
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer / lifestyle image"
        },

        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP THE LOOK"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]
    }

  ],

  "max_blocks": 5,

  "presets": [
    {
      "name": "Track Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}