<section
  id="TrackRecommended-{{ section.id }}"
  class="track-recommended"
  style="
    --tr-bg: {{ section.settings.background_color }};
    --tr-text: {{ section.settings.text_color }};
    --tr-border: {{ section.settings.border_color }};
    --tr-accent: {{ section.settings.accent_color }};
    --tr-card-bg: {{ section.settings.card_background }};
  "
>

  <!-- =========================
       HEADER
  ========================== -->
  <div class="tr-head">

    <div class="tr-head-left">

      {% if section.settings.eyebrow != blank %}
        <div class="tr-eyebrow">
          <span class="tr-eyebrow-dot"></span>
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tr-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

    </div>


    <div class="tr-head-right">

      {% if section.settings.intro != blank %}
        <div class="tr-intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}

      {% if section.settings.collection != blank and section.settings.show_view_all %}
        <a
          href="{{ section.settings.collection.url }}"
          class="tr-view-all"
        >
          <span>VIEW COLLECTION</span>
          <span>↗</span>
        </a>
      {% endif %}

    </div>

  </div>


  {% if section.settings.collection != blank %}

    <!-- =========================
         PRODUCT RAIL
    ========================== -->
    <div class="tr-rail-wrap">

      <div
        class="tr-rail"
        data-tr-rail
      >

        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}

          {% assign current_variant = product.selected_or_first_available_variant %}
          {% assign current_image = current_variant.featured_image | default: product.featured_image %}

          <article
            class="tr-card {% if forloop.first %}tr-card--featured{% endif %}"
            data-tr-card
          >

            <!-- PRODUCT MEDIA -->
            <a
              href="{{ product.url }}?variant={{ current_variant.id }}"
              class="tr-media"
              data-tr-product-link
            >

              {% if current_image != blank %}

                <img
                  src="{{ current_image | image_url: width: 1400 }}"
                  alt="{{ current_image.alt | default: product.title | escape }}"
                  width="{{ current_image.width }}"
                  height="{{ current_image.height }}"
                  class="tr-product-image"
                  loading="lazy"
                  data-tr-image
                >

              {% else %}

                {{ 'product-1' | placeholder_svg_tag: 'tr-placeholder' }}

              {% endif %}


              <!-- number -->
              <div class="tr-product-number">
                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}
              </div>


              {% if forloop.first %}
                <div class="tr-editor-badge">
                  <span class="tr-editor-dot"></span>
                  EDITOR'S PICK
                </div>
              {% endif %}


              <!-- SALE -->
              {% if current_variant.compare_at_price > current_variant.price %}

                {% assign saving = current_variant.compare_at_price | minus: current_variant.price %}

                {% assign saving_percent = saving
                  | times: 100.0
                  | divided_by: current_variant.compare_at_price
                  | round
                %}

                <span class="tr-sale-badge">
                  -{{ saving_percent }}%
                </span>

              {% endif %}


              <!-- hover button -->
              <div class="tr-hover-action">
                <span>EXPLORE PRODUCT</span>

                <span class="tr-hover-circle">
                  ↗
                </span>
              </div>


              <div class="tr-media-glow"></div>

            </a>


            <!-- CONTENT -->
            <div class="tr-content">

              <div class="tr-product-head">

                <div>

                  {% if section.settings.show_vendor and product.vendor != blank %}
                    <div class="tr-vendor">
                      {{ product.vendor }}
                    </div>
                  {% endif %}

                  <a
                    href="{{ product.url }}?variant={{ current_variant.id }}"
                    class="tr-title"
                    data-tr-title-link
                  >
                    {{ product.title }}
                  </a>

                </div>

                <span class="tr-small-arrow">
                  ↗
                </span>

              </div>


              <!-- =========================
                   COLOR OPTIONS
              ========================== -->
              {% if section.settings.show_swatches %}

                {% for option in product.options_with_values %}

                  {% assign option_downcase = option.name | downcase %}

                  {% if option_downcase contains 'color' or option_downcase contains 'colour' %}

                    <div class="tr-color-section">

                      <div class="tr-color-header">

                        <span>COLOR</span>

                        <strong data-tr-color-name>
                          {{ option.selected_value }}
                        </strong>

                      </div>


                      <div class="tr-swatches">

                        {% for option_value in option.values limit: 7 %}

                          {% assign color_name = option_value.name %}
                          {% assign color_handle = color_name | handleize %}
                          {% assign color_variant = blank %}


                          <!-- FIND FIRST VARIANT MATCHING COLOR -->
                          {% for variant in product.variants %}

                            {% assign variant_color = '' %}

                            {% if option.position == 1 %}
                              {% assign variant_color = variant.option1 %}

                            {% elsif option.position == 2 %}
                              {% assign variant_color = variant.option2 %}

                            {% elsif option.position == 3 %}
                              {% assign variant_color = variant.option3 %}
                            {% endif %}


                            {% if variant_color == color_name %}
                              {% assign color_variant = variant %}
                              {% break %}
                            {% endif %}

                          {% endfor %}


                          {% if color_variant == blank %}
                            {% assign color_variant = current_variant %}
                          {% endif %}


                          {% assign color_image = color_variant.featured_image | default: product.featured_image %}


                          <button
                            type="button"
                            class="
                              tr-swatch
                              tr-color--{{ color_handle }}
                              {% if color_name == option.selected_value %}is-active{% endif %}
                            "
                            title="{{ color_name | escape }}"
                            aria-label="Choose {{ color_name | escape }}"
                            data-tr-swatch
                            data-color="{{ color_name | escape }}"
                            data-variant="{{ color_variant.id }}"
                            data-url="{{ product.url }}?variant={{ color_variant.id }}"
                            data-price="{{ color_variant.price | money | escape }}"
                            data-compare="{% if color_variant.compare_at_price > color_variant.price %}{{ color_variant.compare_at_price | money | escape }}{% endif %}"
                            {% if color_image != blank %}
                              data-image="{{ color_image | image_url: width: 1400 }}"
                            {% endif %}
                          >

                            <span class="tr-swatch-color"></span>

                          </button>

                        {% endfor %}

                      </div>

                    </div>

                  {% endif %}

                {% endfor %}

              {% endif %}


              <!-- PRICE + ADD -->
              <div class="tr-bottom">

                <div class="tr-price-wrap">

                  <span
                    class="tr-price"
                    data-tr-price
                  >
                    {{ current_variant.price | money }}
                  </span>


                  <span
                    class="tr-compare"
                    data-tr-compare
                    {% unless current_variant.compare_at_price > current_variant.price %}
                      hidden
                    {% endunless %}
                  >
                    {% if current_variant.compare_at_price > current_variant.price %}
                      {{ current_variant.compare_at_price | money }}
                    {% endif %}
                  </span>

                </div>


                {% if section.settings.enable_quick_add %}

                  {% if product.available %}

                    <form
                      method="post"
                      action="{{ routes.cart_add_url }}"
                      class="tr-add-form"
                    >

                      <input
                        type="hidden"
                        name="id"
                        value="{{ current_variant.id }}"
                        data-tr-variant-input
                      >

                      <button
                        type="submit"
                        class="tr-add"
                      >

                        <span>QUICK ADD</span>

                        <span class="tr-add-circle">
                          +
                        </span>

                      </button>

                    </form>

                  {% else %}

                    <span class="tr-sold">
                      SOLD OUT
                    </span>

                  {% endif %}

                {% endif %}

              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    </div>


    <!-- =========================
         BOTTOM CONTROLS
    ========================== -->
    <div class="tr-controls">

      <div class="tr-progress-wrap">

        <div class="tr-progress-track">
          <span
            class="tr-progress-bar"
            data-tr-progress
          ></span>
        </div>

        <div class="tr-progress-meta">
          <span>DISCOVER MORE</span>
          <span data-tr-position>01</span>
        </div>

      </div>


      <div class="tr-arrows">

        <button
          type="button"
          class="tr-arrow"
          data-tr-prev
          aria-label="Previous products"
        >
          ←
        </button>

        <button
          type="button"
          class="tr-arrow tr-arrow--next"
          data-tr-next
          aria-label="Next products"
        >
          →
        </button>

      </div>

    </div>


  {% else %}

    <div class="tr-empty">

      <span>01</span>

      <p>
        Select a recommendation collection in the Theme Editor.
      </p>

    </div>

  {% endif %}

</section>


<style>

/* ==================================================
   BASE
================================================== */

#TrackRecommended-{{ section.id }} {

  background:
    var(--tr-bg);

  color:
    var(--tr-text);

  overflow: hidden;

  border-top:
    1px solid
    var(--tr-border);
}


/* ==================================================
   HEADER
================================================== */

#TrackRecommended-{{ section.id }}
.tr-head {

  display: grid;

  grid-template-columns:
    minmax(0,1.45fr)
    minmax(280px,.55fr);

  align-items: end;

  gap: 50px;

  padding:
    74px 30px
    42px;

  border-bottom:
    1px solid
    var(--tr-border);
}


#TrackRecommended-{{ section.id }}
.tr-eyebrow {

  margin-bottom: 14px;

  display: flex;

  align-items: center;

  gap: 9px;

  font-size: 10px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .18em;

  text-transform: uppercase;

  opacity: .52;
}


#TrackRecommended-{{ section.id }}
.tr-eyebrow-dot {

  width: 7px;
  height: 7px;

  border-radius: 50%;

  background:
    var(--tr-accent);

  border:
    1px solid #000;
}


#TrackRecommended-{{ section.id }}
.tr-heading {

  margin: 0;

  max-width: 1200px;

  font-size:
    clamp(
      62px,
      6.7vw,
      128px
    );

  line-height: .84;

  font-weight: 500;

  letter-spacing: -.07em;
}


#TrackRecommended-{{ section.id }}
.tr-head-right {

  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 26px;
}


#TrackRecommended-{{ section.id }}
.tr-intro {

  max-width: 390px;

  font-size: 15px;

  line-height: 1.45;

  opacity: .66;
}


#TrackRecommended-{{ section.id }}
.tr-intro p {

  margin: 0;
}


#TrackRecommended-{{ section.id }}
.tr-view-all {

  display: inline-flex;

  align-items: center;

  gap: 12px;

  padding-bottom: 7px;

  color: inherit;

  text-decoration: none;

  border-bottom:
    1px solid
    currentColor;

  font-size: 10px;

  letter-spacing: .12em;

  transition:
    gap .25s ease,
    opacity .25s ease;
}


#TrackRecommended-{{ section.id }}
.tr-view-all:hover {

  gap: 19px;

  opacity: .6;
}


/* ==================================================
   RAIL
================================================== */

#TrackRecommended-{{ section.id }}
.tr-rail-wrap {

  width: 100%;

  overflow: hidden;
}


#TrackRecommended-{{ section.id }}
.tr-rail {

  display: flex;

  align-items: stretch;

  overflow-x: auto;

  scroll-behavior: smooth;

  scroll-snap-type:
    x mandatory;

  overscroll-behavior-x:
    contain;

  scrollbar-width: none;
}


#TrackRecommended-{{ section.id }}
.tr-rail::-webkit-scrollbar {

  display: none;
}


/* ==================================================
   PRODUCT CARD
================================================== */

#TrackRecommended-{{ section.id }}
.tr-card {

  flex:
    0 0
    clamp(
      330px,
      27vw,
      520px
    );

  min-width: 0;

  scroll-snap-align: start;

  background:
    var(--tr-card-bg);

  border-right:
    1px solid
    var(--tr-border);

  transition:
    background .3s ease;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured {

  flex-basis:
    clamp(
      480px,
      41vw,
      780px
    );
}


@media (hover:hover) {

  #TrackRecommended-{{ section.id }}
  .tr-card:hover {

    background: #e9e9e5;
  }

}


/* ==================================================
   PRODUCT MEDIA
================================================== */

#TrackRecommended-{{ section.id }}
.tr-media {

  position: relative;

  display: block;

  overflow: hidden;

  height:
    clamp(
      440px,
      47vw,
      700px
    );

  margin:
    14px 14px 0;

  background:
    linear-gradient(
      145deg,
      #fafafa 0%,
      #f1f1ef 100%
    );

  color: inherit;

  text-decoration: none;
}


#TrackRecommended-{{ section.id }}
.tr-card:not(.tr-card--featured)
.tr-media {

  height:
    clamp(
      410px,
      34vw,
      590px
    );
}


#TrackRecommended-{{ section.id }}
.tr-product-image,
#TrackRecommended-{{ section.id }}
.tr-placeholder {

  position: relative;

  z-index: 1;

  display: block;

  width: 100%;
  height: 100%;

  padding: 26px;

  object-fit: contain;

  transition:
    transform .65s
    cubic-bezier(.2,.7,.2,1),
    opacity .18s ease;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured
.tr-product-image {

  padding: 38px;
}


@media (hover:hover) {

  #TrackRecommended-{{ section.id }}
  .tr-card:hover
  .tr-product-image {

    transform:
      scale(1.055)
      rotate(-1deg);
  }

}


/* GLOW */

#TrackRecommended-{{ section.id }}
.tr-media-glow {

  position: absolute;

  z-index: 0;

  width: 55%;
  height: 18%;

  left: 22%;
  bottom: 13%;

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      rgba(199,255,0,.15),
      transparent 70%
    );

  filter:
    blur(20px);

  opacity: 0;

  transition:
    opacity .35s ease;

  pointer-events: none;
}


@media (hover:hover) {

  #TrackRecommended-{{ section.id }}
  .tr-card:hover
  .tr-media-glow {

    opacity: 1;
  }

}


/* NUMBER */

#TrackRecommended-{{ section.id }}
.tr-product-number {

  position: absolute;

  z-index: 4;

  left: 13px;
  top: 13px;

  font-size: 9px;

  letter-spacing: .13em;

  opacity: .45;
}


/* EDITOR'S PICK */

#TrackRecommended-{{ section.id }}
.tr-editor-badge {

  position: absolute;

  z-index: 5;

  left: 14px;
  bottom: 14px;

  min-height: 31px;

  padding: 0 12px;

  display: flex;

  align-items: center;

  gap: 8px;

  background:
    var(--tr-accent);

  color: #000;

  border: 1px solid #000;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: .09em;
}


#TrackRecommended-{{ section.id }}
.tr-editor-dot {

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #000;
}


/* SALE */

#TrackRecommended-{{ section.id }}
.tr-sale-badge {

  position: absolute;

  z-index: 5;

  right: 12px;
  top: 12px;

  min-height: 28px;

  padding: 0 9px;

  display: inline-flex;

  align-items: center;

  background: #ff3131;

  color: #fff;

  font-size: 9px;

  font-weight: 700;
}


/* ==================================================
   HOVER ACTION
================================================== */

#TrackRecommended-{{ section.id }}
.tr-hover-action {

  position: absolute;

  z-index: 6;

  left: 14px;
  right: 14px;
  bottom: 14px;

  min-height: 58px;

  padding:
    0 8px
    0 18px;

  display: flex;

  align-items: center;

  justify-content:
    space-between;

  gap: 15px;

  background:
    rgba(0,0,0,.92);

  color: #fff;

  backdrop-filter:
    blur(8px);

  font-size: 9px;

  letter-spacing: .12em;

  transform:
    translateY(85px);

  transition:
    transform .3s ease;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured
.tr-hover-action {

  left: auto;

  width: 220px;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured
.tr-editor-badge {

  transition:
    opacity .2s ease;
}


#TrackRecommended-{{ section.id }}
.tr-hover-circle {

  flex: 0 0 auto;

  width: 40px;
  height: 40px;

  border-radius: 50%;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  background:
    var(--tr-accent);

  color: #000;

  font-size: 17px;
}


@media (hover:hover) {

  #TrackRecommended-{{ section.id }}
  .tr-card:hover
  .tr-hover-action {

    transform:
      translateY(0);
  }


  #TrackRecommended-{{ section.id }}
  .tr-card--featured:hover
  .tr-editor-badge {

    opacity: .2;
  }

}


/* ==================================================
   CONTENT
================================================== */

#TrackRecommended-{{ section.id }}
.tr-content {

  padding:
    19px 18px
    21px;
}


#TrackRecommended-{{ section.id }}
.tr-product-head {

  min-height: 65px;

  display: flex;

  justify-content:
    space-between;

  align-items:
    flex-start;

  gap: 15px;
}


#TrackRecommended-{{ section.id }}
.tr-vendor {

  margin-bottom: 5px;

  font-size: 8px;

  letter-spacing: .13em;

  text-transform: uppercase;

  opacity: .42;
}


#TrackRecommended-{{ section.id }}
.tr-title {

  display: block;

  max-width: 360px;

  color: inherit;

  text-decoration: none;

  font-size: 18px;

  line-height: 1.08;

  font-weight: 500;

  letter-spacing: -.035em;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured
.tr-title {

  font-size: 22px;
}


#TrackRecommended-{{ section.id }}
.tr-small-arrow {

  flex: 0 0 auto;

  font-size: 16px;

  opacity: .35;

  transition:
    opacity .2s ease,
    transform .25s ease;
}


@media (hover:hover) {

  #TrackRecommended-{{ section.id }}
  .tr-card:hover
  .tr-small-arrow {

    opacity: 1;

    transform:
      translate(2px,-2px);
  }

}


/* ==================================================
   COLOR
================================================== */

#TrackRecommended-{{ section.id }}
.tr-color-section {

  margin-top: 5px;
}


#TrackRecommended-{{ section.id }}
.tr-color-header {

  display: flex;

  align-items: center;

  justify-content:
    space-between;

  gap: 12px;

  margin-bottom: 9px;

  min-height: 19px;

  font-size: 8px;

  letter-spacing: .13em;

  text-transform: uppercase;

  opacity: .48;
}


#TrackRecommended-{{ section.id }}
.tr-color-header strong {

  font-weight: 500;
}


/* SWATCHES */

#TrackRecommended-{{ section.id }}
.tr-swatches {

  min-height: 40px;

  display: flex;

  align-items: center;

  gap: 8px;
}


#TrackRecommended-{{ section.id }}
.tr-swatch {

  position: relative;

  appearance: none;

  width: 30px;
  height: 30px;

  padding: 3px;

  border-radius: 50%;

  border:
    1px solid
    transparent;

  background:
    transparent;

  cursor: pointer;

  transition:
    transform .2s ease,
    border-color .2s ease;
}


#TrackRecommended-{{ section.id }}
.tr-swatch:hover {

  transform:
    scale(1.13);
}


#TrackRecommended-{{ section.id }}
.tr-swatch.is-active {

  border-color: #000;
}


#TrackRecommended-{{ section.id }}
.tr-swatch-color {

  display: block;

  width: 100%;
  height: 100%;

  border-radius: 50%;

  border:
    1px solid
    rgba(0,0,0,.15);

  background: #ccc;
}


/* ==================================================
   COLOR MAPPING
================================================== */

#TrackRecommended-{{ section.id }}
.tr-color--black
.tr-swatch-color {

  background: #111;
}


#TrackRecommended-{{ section.id }}
.tr-color--white
.tr-swatch-color {

  background: #fff;
}


#TrackRecommended-{{ section.id }}
.tr-color--grey
.tr-swatch-color,

#TrackRecommended-{{ section.id }}
.tr-color--gray
.tr-swatch-color,

#TrackRecommended-{{ section.id }}
.tr-color--core-grey
.tr-swatch-color,

#TrackRecommended-{{ section.id }}
.tr-color--ice-grey
.tr-swatch-color {

  background: #a9aaac;
}


#TrackRecommended-{{ section.id }}
.tr-color--red
.tr-swatch-color {

  background: #ff3045;
}


#TrackRecommended-{{ section.id }}
.tr-color--yellow
.tr-swatch-color {

  background: #ffe025;
}


#TrackRecommended-{{ section.id }}
.tr-color--green
.tr-swatch-color,

#TrackRecommended-{{ section.id }}
.tr-color--lime
.tr-swatch-color,

#TrackRecommended-{{ section.id }}
.tr-color--hyperlime
.tr-swatch-color {

  background:
    #baff00;
}


#TrackRecommended-{{ section.id }}
.tr-color--blue
.tr-swatch-color {

  background:
    #4385ff;
}


#TrackRecommended-{{ section.id }}
.tr-color--beige
.tr-swatch-color {

  background:
    #ddd4c8;
}


#TrackRecommended-{{ section.id }}
.tr-color--stone
.tr-swatch-color {

  background:
    #d5cec3;
}


#TrackRecommended-{{ section.id }}
.tr-color--orange
.tr-swatch-color {

  background:
    #ff792d;
}


#TrackRecommended-{{ section.id }}
.tr-color--pink
.tr-swatch-color {

  background:
    #f6a3ba;
}


/* ==================================================
   PRICE / ADD
================================================== */

#TrackRecommended-{{ section.id }}
.tr-bottom {

  margin-top: 12px;

  padding-top: 14px;

  display: flex;

  align-items: flex-end;

  justify-content:
    space-between;

  gap: 12px;

  border-top:
    1px solid
    rgba(0,0,0,.17);
}


#TrackRecommended-{{ section.id }}
.tr-price-wrap {

  display: flex;

  flex-wrap: wrap;

  align-items: baseline;

  gap: 7px;
}


#TrackRecommended-{{ section.id }}
.tr-price {

  font-size: 22px;

  line-height: 1;

  font-weight: 500;

  letter-spacing: -.045em;
}


#TrackRecommended-{{ section.id }}
.tr-card--featured
.tr-price {

  font-size: 27px;
}


#TrackRecommended-{{ section.id }}
.tr-compare {

  font-size: 11px;

  text-decoration:
    line-through;

  opacity: .32;
}


/* QUICK ADD */

