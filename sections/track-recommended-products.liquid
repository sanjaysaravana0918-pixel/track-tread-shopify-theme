</style>


<script>
(function () {

  var section = document.getElementById(
    'TrackRecommended-{{ section.id }}'
  );

  if (!section) {
    return;
  }


  /* ==================================================
     VARIANT SWATCHES
  ================================================== */

  var cards = section.querySelectorAll(
    '[data-tr-card]'
  );


  cards.forEach(function (card) {

    var image = card.querySelector(
      '[data-tr-image]'
    );

    var price = card.querySelector(
      '[data-tr-price]'
    );

    var comparePrice = card.querySelector(
      '[data-tr-compare]'
    );

    var variantInput = card.querySelector(
      '[data-tr-variant-input]'
    );

    var colorLabel = card.querySelector(
      '[data-tr-color-name]'
    );

    var productLink = card.querySelector(
      '[data-tr-product-link]'
    );

    var titleLink = card.querySelector(
      '[data-tr-title-link]'
    );

    var swatches = card.querySelectorAll(
      '[data-tr-swatch]'
    );


    swatches.forEach(function (swatch) {

      swatch.addEventListener(
        'click',
        function () {

          var newImage = swatch.getAttribute(
            'data-image'
          );

          var newVariant = swatch.getAttribute(
            'data-variant'
          );

          var newUrl = swatch.getAttribute(
            'data-url'
          );

          var newPrice = swatch.getAttribute(
            'data-price'
          );

          var newCompare = swatch.getAttribute(
            'data-compare'
          );

          var newColor = swatch.getAttribute(
            'data-color'
          );


          /* ACTIVE */

          swatches.forEach(function (item) {

            item.classList.remove(
              'is-active'
            );

          });

          swatch.classList.add(
            'is-active'
          );


          /* COLOR NAME */

          if (
            colorLabel &&
            newColor
          ) {

            colorLabel.textContent =
              newColor;

          }


          /* IMAGE */

          if (
            image &&
            newImage
          ) {

            image.style.opacity =
              '0';

            image.style.transform =
              'scale(.96)';


            var preload =
              new Image();


            preload.onload =
              function () {

                image.removeAttribute(
                  'srcset'
                );

                image.src =
                  newImage;

                image.style.opacity =
                  '1';

                image.style.transform =
                  'scale(1)';

              };


            preload.onerror =
              function () {

                image.style.opacity =
                  '1';

                image.style.transform =
                  'scale(1)';

              };


            preload.src =
              newImage;

          }


          /* PRICE */

          if (
            price &&
            newPrice
          ) {

            price.textContent =
              newPrice;

          }


          /* COMPARE */

          if (comparePrice) {

            if (newCompare) {

              comparePrice.textContent =
                newCompare;

              comparePrice.hidden =
                false;

            } else {

              comparePrice.textContent =
                '';

              comparePrice.hidden =
                true;

            }

          }


          /* QUICK ADD */

          if (
            variantInput &&
            newVariant
          ) {

            variantInput.value =
              newVariant;

          }


          /* LINKS */

          if (newUrl) {

            if (productLink) {

              productLink.href =
                newUrl;

            }

            if (titleLink) {

              titleLink.href =
                newUrl;

            }

          }

        }
      );

    });

  });


  /* ==================================================
     PRODUCT RAIL
  ================================================== */

  var rail = section.querySelector(
    '[data-tr-rail]'
  );

  var prev = section.querySelector(
    '[data-tr-prev]'
  );

  var next = section.querySelector(
    '[data-tr-next]'
  );

  var progress = section.querySelector(
    '[data-tr-progress]'
  );

  var position = section.querySelector(
    '[data-tr-position]'
  );


  if (!rail) {
    return;
  }


  function getScrollAmount() {

    var firstCard =
      rail.querySelector(
        '[data-tr-card]'
      );

    if (!firstCard) {
      return 400;
    }

    return (
      firstCard.getBoundingClientRect().width
      * 0.8
    );

  }


  if (next) {

    next.addEventListener(
      'click',
      function () {

        rail.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });

      }
    );

  }


  if (prev) {

    prev.addEventListener(
      'click',
      function () {

        rail.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });

      }
    );

  }


  function updateProgress() {

    var maxScroll =
      rail.scrollWidth -
      rail.clientWidth;


    var percent = 0;


    if (maxScroll > 0) {

      percent =
        rail.scrollLeft /
        maxScroll;

    }


    var progressWidth =
      15 +
      (percent * 85);


    if (progress) {

      progress.style.width =
        progressWidth + '%';

    }


    if (position) {

      var cardsArray =
        Array.prototype.slice.call(
          cards
        );


      var closestIndex = 0;

      var closestDistance =
        Infinity;


      cardsArray.forEach(
        function (card, index) {

          var distance =
            Math.abs(
              card.offsetLeft -
              rail.scrollLeft
            );


          if (
            distance <
            closestDistance
          ) {

            closestDistance =
              distance;

            closestIndex =
              index;

          }

        }
      );


      var displayNumber =
        closestIndex + 1;


      position.textContent =
        displayNumber < 10
          ? '0' + displayNumber
          : displayNumber;

    }

  }


  rail.addEventListener(
    'scroll',
    updateProgress,
    { passive: true }
  );


  updateProgress();

})();
</script>


