<section
  id="TrackHero-{{ section.id }}"
  class="track-hero"
  style="
    --track-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --track-hero-text: {{ section.settings.text_color }};
  "
>
  <div class="track-hero__media">

    {% if section.settings.desktop_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
          >
        {% endif %}

        {{
          section.settings.desktop_image
          | image_url: width: 2400
          | image_tag:
            class: 'track-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 1800, 2200, 2400',
            sizes: '100vw',
            alt: section.settings.desktop_image.alt
        }}
      </picture>
    {% else %}
      <div class="track-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}

    <div class="track-hero__overlay"></div>
  </div>

  <div class="track-hero__content">
    <div class="track-hero__content-inner">

      {% if section.settings.eyebrow != blank %}
        <div class="track-hero__eyebrow">
          <span class="track-hero__eyebrow-line"></span>
          <span>{{ section.settings.eyebrow }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="track-hero__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="track-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="track-hero__actions">
        {% if section.settings.primary_label != blank %}
          <a
            class="track-hero__button track-hero__button--primary"
            {% if section.settings.primary_link != blank %}
              href="{{ section.settings.primary_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ section.settings.primary_label }}</span>
            <span class="track-hero__arrow" aria-hidden="true">↗</span>
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            class="track-hero__button track-hero__button--secondary"
            {% if section.settings.secondary_link != blank %}
              href="{{ section.settings.secondary_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ section.settings.secondary_label }}</span>
            <span class="track-hero__arrow" aria-hidden="true">↗</span>
          </a>
        {% endif %}
      </div>

    </div>

    {% if section.settings.show_side_label %}
      <div class="track-hero__side-label">
        <span>TRACK&TREAD</span>
        <span>EST. 2026</span>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #TrackHero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 650px;
    height: calc(100vh - 72px);
    max-height: 980px;
    overflow: hidden;
    background: #111;
    color: var(--track-hero-text);
  }

  #TrackHero-{{ section.id }} .track-hero__media {
    position: absolute;
    inset: 0;
  }

  #TrackHero-{{ section.id }} picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TrackHero-{{ section.id }} .track-hero__image,
  #TrackHero-{{ section.id }} .track-hero__placeholder,
  #TrackHero-{{ section.id }} .track-hero__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #TrackHero-{{ section.id }} .track-hero__image {
    object-fit: cover;
    object-position: center;
    transform: scale(1.001);
    transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
  }

  @media (hover: hover) {
    #TrackHero-{{ section.id }}:hover .track-hero__image {
      transform: scale(1.025);
    }
  }

  #TrackHero-{{ section.id }} .track-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(0,0,0,var(--track-hero-overlay)) 0%,
        rgba(0,0,0,calc(var(--track-hero-overlay) * .68)) 42%,
        rgba(0,0,0,.08) 75%,
        rgba(0,0,0,.04) 100%
      );
    pointer-events: none;
  }

  #TrackHero-{{ section.id }} .track-hero__content {
    position: relative;
    z-index: 2;
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: flex-end;
    padding: 72px 32px 54px;
  }

  #TrackHero-{{ section.id }} .track-hero__content-inner {
    width: min(1100px, 86vw);
  }

  #TrackHero-{{ section.id }} .track-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #TrackHero-{{ section.id }} .track-hero__eyebrow-line {
    display: block;
    width: 42px;
    height: 1px;
    background: currentColor;
  }

  #TrackHero-{{ section.id }} .track-hero__heading {
    max-width: 1180px;
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: clamp(64px, 7.3vw, 138px);
    line-height: .89;
    font-weight: 500;
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  #TrackHero-{{ section.id }} .track-hero__description {
    max-width: 560px;
    margin-top: 25px;
    font-size: clamp(16px, 1.15vw, 21px);
    line-height: 1.4;
  }

  #TrackHero-{{ section.id }} .track-hero__description p {
    margin: 0;
  }

  #TrackHero-{{ section.id }} .track-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }

  #TrackHero-{{ section.id }} .track-hero__button {
    min-width: 170px;
    min-height: 58px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    border: 1px solid #fff;
    text-decoration: none;
    font-size: 16px;
    line-height: 1;
    transition:
      background .25s ease,
      color .25s ease,
      transform .25s ease;
  }

  #TrackHero-{{ section.id }} .track-hero__button--primary {
    background: #fff;
    color: #000;
  }

  #TrackHero-{{ section.id }} .track-hero__button--secondary {
    background: transparent;
    color: #fff;
  }

  #TrackHero-{{ section.id }} .track-hero__button:hover {
    transform: translateY(-2px);
  }

  #TrackHero-{{ section.id }} .track-hero__button--primary:hover {
    background: #c7ff00;
    border-color: #c7ff00;
  }

  #TrackHero-{{ section.id }} .track-hero__button--secondary:hover {
    background: #fff;
    color: #000;
  }

  #TrackHero-{{ section.id }} .track-hero__arrow {
    font-size: 20px;
    transition: transform .25s ease;
  }

  #TrackHero-{{ section.id }} .track-hero__button:hover .track-hero__arrow {
    transform: translate(3px, -3px);
  }

  #TrackHero-{{ section.id }} .track-hero__side-label {
    position: absolute;
    right: 28px;
    bottom: 54px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .85;
  }

  @media screen and (max-width: 989px) {
    #TrackHero-{{ section.id }} {
      min-height: 680px;
      height: 82svh;
      max-height: none;
    }

    #TrackHero-{{ section.id }} .track-hero__content {
      padding: 48px 22px 38px;
    }

    #TrackHero-{{ section.id }} .track-hero__heading {
      font-size: clamp(54px, 10vw, 88px);
      line-height: .92;
    }

    #TrackHero-{{ section.id }} .track-hero__content-inner {
      width: 94%;
    }
  }

  @media screen and (max-width: 749px) {
    #TrackHero-{{ section.id }} {
      min-height: 690px;
      height: 86svh;
    }

    #TrackHero-{{ section.id }} .track-hero__image {
      object-position: center center;
    }

    #TrackHero-{{ section.id }} .track-hero__overlay {
      background:
        linear-gradient(
          0deg,
          rgba(0,0,0,.78) 0%,
          rgba(0,0,0,.44) 42%,
          rgba(0,0,0,.08) 78%
        );
    }

    #TrackHero-{{ section.id }} .track-hero__content {
      align-items: flex-end;
      padding: 38px 18px 28px;
    }

    #TrackHero-{{ section.id }} .track-hero__eyebrow {
      margin-bottom: 14px;
      font-size: 11px;
    }

    #TrackHero-{{ section.id }} .track-hero__heading {
      font-size: clamp(48px, 14vw, 72px);
      line-height: .9;
      letter-spacing: -.055em;
    }

    #TrackHero-{{ section.id }} .track-hero__description {
      margin-top: 17px;
      font-size: 15px;
      max-width: 92%;
    }

    #TrackHero-{{ section.id }} .track-hero__actions {
      width: 100%;
      margin-top: 23px;
      gap: 8px;
    }

    #TrackHero-{{ section.id }} .track-hero__button {
      min-width: 0;
      flex: 1 1 calc(50% - 4px);
      min-height: 54px;
      padding: 0 14px;
      gap: 10px;
      font-size: 14px;
    }

    #TrackHero-{{ section.id }} .track-hero__side-label {
      display: none;
    }
  }

  @media screen and (max-width: 430px) {
    #TrackHero-{{ section.id }} .track-hero__heading {
      font-size: 50px;
    }

    #TrackHero-{{ section.id }} .track-hero__button {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TrackHero-{{ section.id }} .track-hero__image,
    #TrackHero-{{ section.id }} .track-hero__button,
    #TrackHero-{{ section.id }} .track-hero__arrow {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "Track Hero",
  "tag": "section",
  "class": "track-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LIMITED EDITION — 2026"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "MOVE DIFFERENT. WEAR TRACK&TREAD."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Performance-inspired essentials designed for movement, comfort and everyday style.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "SHOP MEN"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "SHOP WOMEN"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_side_label",
      "label": "Show side brand label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Track Hero"
    }
  ]
}
{% endschema %}