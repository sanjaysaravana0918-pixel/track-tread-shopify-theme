<section
  id="TrackCategoryMosaic-{{ section.id }}"
  class="track-category-runway"
  style="
    --tcr-bg: {{ section.settings.background_color }};
    --tcr-text: {{ section.settings.text_color }};
    --tcr-accent: {{ section.settings.accent_color }};
    --tcr-border: {{ section.settings.border_color }};
  "
>

  <div class="tcr-head">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="tcr-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tcr-heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.settings.intro != blank %}
      <div class="tcr-intro">
        {{ section.settings.intro }}
      </div>
    {% endif %}
  </div>


  <!-- FEATURED CATEGORY -->
  <a
    class="tcr-feature"
    {% if section.settings.link_one != blank %}
      href="{{ section.settings.link_one }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >

    <div class="tcr-feature-media">
      {% if section.settings.image_one != blank %}
        {{
          section.settings.image_one
          | image_url: width: 2200
          | image_tag:
            class: 'tcr-image',
            loading: 'lazy',
            widths: '900, 1200, 1600, 2000, 2200',
            sizes: '100vw',
            alt: section.settings.image_one.alt
        }}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag: 'tcr-placeholder' }}
      {% endif %}

      <div class="tcr-feature-overlay"></div>

      <span class="tcr-feature-number">01</span>

      <div class="tcr-feature-badge">
        {{ section.settings.label_one }}
      </div>
    </div>

    <div class="tcr-feature-bottom">

      <div>
        <span class="tcr-kicker">{{ section.settings.count_one }}</span>
        <h3 class="tcr-feature-title">{{ section.settings.title_one }}</h3>
      </div>

      <div class="tcr-feature-action">
        <span>EXPLORE</span>
        <span class="tcr-action-circle">↗</span>
      </div>

    </div>

  </a>


  <!-- ROW 02 -->
  <a
    class="tcr-row"
    {% if section.settings.link_two != blank %}
      href="{{ section.settings.link_two }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >

    <div class="tcr-row-copy">
      <div class="tcr-row-top">
        <span class="tcr-row-number">02</span>
        <span>{{ section.settings.count_two }}</span>
      </div>

      <div>
        <span class="tcr-row-label">{{ section.settings.label_two }}</span>
        <h3 class="tcr-row-title">{{ section.settings.title_two }}</h3>
      </div>

      <div class="tcr-row-footer">
        <span>SHOP CATEGORY</span>
        <span class="tcr-row-arrow">→</span>
      </div>
    </div>

    <div class="tcr-row-media">
      {% if section.settings.image_two != blank %}
        {{
          section.settings.image_two
          | image_url: width: 1600
          | image_tag:
            class: 'tcr-image',
            loading: 'lazy',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 58vw, 100vw',
            alt: section.settings.image_two.alt
        }}
      {% else %}
        {{ 'collection-2' | placeholder_svg_tag: 'tcr-placeholder' }}
      {% endif %}
    </div>

  </a>


  <!-- ROW 03 -->
  <a
    class="tcr-row tcr-row--reverse"
    {% if section.settings.link_three != blank %}
      href="{{ section.settings.link_three }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >

    <div class="tcr-row-media">
      {% if section.settings.image_three != blank %}
        {{
          section.settings.image_three
          | image_url: width: 1600
          | image_tag:
            class: 'tcr-image',
            loading: 'lazy',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 58vw, 100vw',
            alt: section.settings.image_three.alt
        }}
      {% else %}
        {{ 'collection-3' | placeholder_svg_tag: 'tcr-placeholder' }}
      {% endif %}
    </div>

    <div class="tcr-row-copy">
      <div class="tcr-row-top">
        <span class="tcr-row-number">03</span>
        <span>{{ section.settings.count_three }}</span>
      </div>

      <div>
        <span class="tcr-row-label">{{ section.settings.label_three }}</span>
        <h3 class="tcr-row-title">{{ section.settings.title_three }}</h3>
      </div>

      <div class="tcr-row-footer">
        <span>SHOP CATEGORY</span>
        <span class="tcr-row-arrow">→</span>
      </div>
    </div>

  </a>


  <!-- ROW 04 -->
  <a
    class="tcr-row"
    {% if section.settings.link_four != blank %}
      href="{{ section.settings.link_four }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >

    <div class="tcr-row-copy">
      <div class="tcr-row-top">
        <span class="tcr-row-number">04</span>
        <span>{{ section.settings.count_four }}</span>
      </div>

      <div>
        <span class="tcr-row-label">{{ section.settings.label_four }}</span>
        <h3 class="tcr-row-title">{{ section.settings.title_four }}</h3>
      </div>

      <div class="tcr-row-footer">
        <span>DISCOVER NEW</span>
        <span class="tcr-row-arrow">→</span>
      </div>
    </div>

    <div class="tcr-row-media">
      {% if section.settings.image_four != blank %}
        {{
          section.settings.image_four
          | image_url: width: 1600
          | image_tag:
            class: 'tcr-image',
            loading: 'lazy',
            widths: '600, 900, 1200, 1600',
            sizes: '(min-width: 990px) 58vw, 100vw',
            alt: section.settings.image_four.alt
        }}
      {% else %}
        {{ 'collection-4' | placeholder_svg_tag: 'tcr-placeholder' }}
      {% endif %}
    </div>

  </a>


  {% if section.settings.show_footer_strip %}
    <div class="tcr-bottom-strip">
      <span>{{ section.settings.footer_small }}</span>

      <strong>{{ section.settings.footer_large }}</strong>

      <span class="tcr-bottom-arrow">↗</span>
    </div>
  {% endif %}

</section>


<style>

#TrackCategoryMosaic-{{ section.id }} {
  background: var(--tcr-bg);
  color: var(--tcr-text);
  overflow: hidden;
}


/* HEADER */

#TrackCategoryMosaic-{{ section.id }} .tcr-head {
  display: grid;
  grid-template-columns: 1.45fr .55fr;
  align-items: end;
  gap: 40px;

  padding: 72px 28px 40px;

  border-top: 1px solid var(--tcr-border);
  border-bottom: 1px solid var(--tcr-border);
}

#TrackCategoryMosaic-{{ section.id }} .tcr-eyebrow {
  margin: 0 0 12px;

  font-size: 10px;
  font-weight: 700;

  letter-spacing: .18em;
  text-transform: uppercase;

  opacity: .5;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-heading {
  margin: 0;

  font-size: clamp(64px, 7vw, 132px);
  line-height: .84;

  font-weight: 500;
  letter-spacing: -.07em;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-intro {
  max-width: 350px;

  margin-left: auto;

  font-size: 15px;
  line-height: 1.45;

  opacity: .65;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-intro p {
  margin: 0;
}


/* FEATURE */

#TrackCategoryMosaic-{{ section.id }} .tcr-feature {
  display: block;

  color: inherit;
  text-decoration: none;

  border-bottom: 1px solid var(--tcr-border);
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-media {
  position: relative;

  min-height: 720px;

  overflow: hidden;

  background: #111;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-image,
#TrackCategoryMosaic-{{ section.id }} .tcr-placeholder {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform 1.1s cubic-bezier(.2,.7,.2,1),
    filter .45s ease;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      180deg,
      rgba(0,0,0,.02),
      rgba(0,0,0,.08) 55%,
      rgba(0,0,0,.4)
    );
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-number {
  position: absolute;

  top: 22px;
  left: 24px;

  z-index: 3;

  min-width: 44px;
  height: 27px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--tcr-accent);
  color: #000;

  font-size: 9px;
  font-weight: 700;

  border: 1px solid #000;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-badge {
  position: absolute;

  right: 24px;
  top: 22px;

  z-index: 3;

  padding: 8px 12px;

  background: rgba(255,255,255,.92);
  color: #000;

  backdrop-filter: blur(8px);

  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: .12em;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-bottom {
  display: flex;

  align-items: flex-end;
  justify-content: space-between;

  gap: 30px;

  padding: 26px 28px 30px;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-kicker {
  display: block;

  margin-bottom: 8px;

  font-size: 9px;

  letter-spacing: .14em;
  text-transform: uppercase;

  opacity: .5;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-title {
  margin: 0;

  font-size: clamp(74px, 8vw, 148px);
  line-height: .8;

  font-weight: 500;

  letter-spacing: -.075em;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-feature-action {
  display: flex;

  align-items: center;

  gap: 16px;

  font-size: 10px;

  letter-spacing: .13em;
  text-transform: uppercase;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-action-circle {
  width: 60px;
  height: 60px;

  border-radius: 50%;

  display: flex;

  align-items: center;
  justify-content: center;

  background: #000;
  color: #fff;

  font-size: 22px;

  transition:
    transform .3s ease,
    background .3s ease,
    color .3s ease;
}


/* ROWS */

#TrackCategoryMosaic-{{ section.id }} .tcr-row {
  display: grid;

  grid-template-columns: 42% 58%;

  min-height: 480px;

  color: inherit;
  text-decoration: none;

  border-bottom: 1px solid var(--tcr-border);
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-copy {
  position: relative;

  padding: 26px 26px 24px;

  display: flex;
  flex-direction: column;

  justify-content: space-between;

  border-right: 1px solid var(--tcr-border);

  transition: background .3s ease;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row--reverse .tcr-row-media {
  border-right: 1px solid var(--tcr-border);
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row--reverse .tcr-row-copy {
  border-right: 0;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-media {
  position: relative;

  overflow: hidden;

  min-height: 480px;

  background: #111;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  font-size: 9px;

  text-transform: uppercase;
  letter-spacing: .13em;

  opacity: .55;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-number {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 40px;
  height: 25px;

  background: var(--tcr-accent);
  color: #000;

  border: 1px solid #000;

  opacity: 1;

  font-weight: 700;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-label {
  display: block;

  margin-bottom: 7px;

  font-size: 9px;

  letter-spacing: .13em;
  text-transform: uppercase;

  opacity: .48;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-title {
  margin: 0;

  max-width: 600px;

  font-size: clamp(52px, 5vw, 92px);
  line-height: .84;

  font-weight: 500;

  letter-spacing: -.065em;

  transition: transform .3s ease;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-footer {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding-top: 15px;

  border-top: 1px solid rgba(0,0,0,.25);

  font-size: 9px;

  letter-spacing: .13em;
  text-transform: uppercase;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-row-arrow {
  font-size: 28px;

  transition: transform .3s ease;
}


/* HOVER */

@media (hover:hover) {

  #TrackCategoryMosaic-{{ section.id }}
  .tcr-feature:hover
  .tcr-image {

    transform: scale(1.04);
    filter: saturate(1.06);
  }

  #TrackCategoryMosaic-{{ section.id }}
  .tcr-feature:hover
  .tcr-action-circle {

    transform:
      rotate(45deg)
      scale(1.06);

    background: var(--tcr-accent);
    color: #000;
  }


  #TrackCategoryMosaic-{{ section.id }} .tcr-row:hover .tcr-row-copy {
    background: var(--tcr-accent);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row:hover .tcr-image {
    transform: scale(1.06);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row:hover .tcr-row-title {
    transform: translateX(8px);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row:hover .tcr-row-arrow {
    transform: translateX(8px);
  }

}


/* BOTTOM STRIP */

#TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip {
  min-height: 125px;

  padding: 24px 28px;

  display: grid;

  grid-template-columns: .35fr 1.5fr auto;

  align-items: center;

  gap: 30px;

  background: var(--tcr-accent);
  color: #000;

  border-bottom: 1px solid var(--tcr-border);
}

#TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip > span:first-child {
  font-size: 9px;

  letter-spacing: .13em;
  text-transform: uppercase;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip strong {
  font-size: clamp(30px, 3.3vw, 60px);

  line-height: .95;

  font-weight: 500;

  letter-spacing: -.05em;
}

#TrackCategoryMosaic-{{ section.id }} .tcr-bottom-arrow {
  width: 58px;
  height: 58px;

  border-radius: 50%;

  border: 1px solid #000;

  display: flex;

  align-items: center;
  justify-content: center;

  font-size: 22px;
}


/* TABLET */

@media screen and (max-width: 989px) {

  #TrackCategoryMosaic-{{ section.id }} .tcr-head {
    grid-template-columns: 1fr;

    gap: 20px;

    padding: 52px 20px 30px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-intro {
    margin-left: 0;
    max-width: 500px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-feature-media {
    min-height: 620px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row {
    min-height: 400px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row-media {
    min-height: 400px;
  }

}


/* MOBILE */

@media screen and (max-width: 749px) {

  #TrackCategoryMosaic-{{ section.id }} .tcr-head {
    padding: 42px 16px 24px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-heading {
    font-size: clamp(52px, 15vw, 76px);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-intro {
    font-size: 14px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-feature-media {
    min-height: 520px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-feature-bottom {
    padding: 20px 16px 22px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-feature-title {
    font-size: clamp(58px, 17vw, 84px);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-feature-action > span:first-child {
    display: none;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-action-circle {
    width: 48px;
    height: 48px;

    font-size: 18px;
  }


  #TrackCategoryMosaic-{{ section.id }} .tcr-row,
  #TrackCategoryMosaic-{{ section.id }} .tcr-row--reverse {

    grid-template-columns: 1fr;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row-copy {
    order: 1;

    min-height: 260px;

    padding: 20px 16px;

    border-right: 0 !important;

    border-bottom: 1px solid var(--tcr-border);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row-media {
    order: 2;

    min-height: 380px;

    border-right: 0 !important;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-row-title {
    font-size: clamp(46px, 14vw, 68px);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip {
    grid-template-columns: 1fr auto;

    padding: 20px 16px;

    gap: 16px;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip > span:first-child {
    grid-column: 1 / -1;
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-bottom-strip strong {
    font-size: clamp(28px, 9vw, 42px);
  }

  #TrackCategoryMosaic-{{ section.id }} .tcr-bottom-arrow {
    width: 48px;
    height: 48px;
  }

}


/* REDUCED MOTION */

@media (prefers-reduced-motion: reduce) {

  #TrackCategoryMosaic-{{ section.id }} .tcr-image,
  #TrackCategoryMosaic-{{ section.id }} .tcr-row-title,
  #TrackCategoryMosaic-{{ section.id }} .tcr-row-arrow,
  #TrackCategoryMosaic-{{ section.id }} .tcr-action-circle {

    transition: none;
  }

}

</style>


{% schema %}
{
  "name": "Track Category Runway",
  "tag": "section",
  "class": "track-category-runway-section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPLORE THE COLLECTION"
    },

    {
