    },

    {
      "type": "url",
      "id": "link_one",
      "label": "Link"
    },

    {
      "type": "header",
      "content": "Category 2"
    },

    {
      "type": "image_picker",
      "id": "image_two",
      "label": "Image"
    },

    {
      "type": "text",
      "id": "label_two",
      "label": "Label",
      "default": "PERFORMANCE"
    },

    {
      "type": "text",
      "id": "count_two",
      "label": "Count",
